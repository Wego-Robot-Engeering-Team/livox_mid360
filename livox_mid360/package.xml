<?xml version="1.0"?>
<package format="3">
  <name>livox_mid360</name>
  <version>0.1.0</version>
  <description>MID-360 acquisition launch, RViz visualization and IMU gravity leveling.</description>
  <maintainer email="junoyoo@wego-robotics.com">juno-wego</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>eigen</depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
